rules_version = '2';

// Security model (docs/GAME_PLAN.md §6.5):
//  - players own users/{uid} and its progress/daily subcollections;
//  - the ledger is append-only for the owner and bounded; the authoritative
//    balance (wallet) and entitlements are written by Cloud Functions only;
//  - leaderboards, dailies, manifests and clue stats are read-only for clients;
//  - telemetry and feedback are write-once by signed-in players;
//  - multiplayer: matches are readable by their players, co-op rooms by their
//    members (who may only write their own cursor/heartbeat and grid cells), the
//    trophy leaderboard is public; queues, invite codes and results are
//    function-only;
//  - authoring collections need the `admin` custom claim.
// Everything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    // Fields of users/{uid} that only Cloud Functions may write (wallet, entitlements,
    // the multiplayer progression: trophies, xp, season points; and the claimed username).
    function serverOnlyUserFields() {
      return ['wallet', 'entitlements', 'entitlementsMeta', 'lastLedgerSyncAt', 'trophies', 'xp', 'season', 'lastMatchAt', 'lastCoopAt', 'username', 'usernameUpdatedAt'];
    }

    function touchesServerOnlyUserFields() {
      return resource == null
        ? request.resource.data.keys().hasAny(serverOnlyUserFields())
        : request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields());
    }

    // Client-authored ledger entry (schema/ledger-entry.schema.json): UUID v7 id
    // equal to the document id, a non-server type, bounded integer amount, no
    // `server` block. Cloud Functions re-validate against the economy and set
    // server.status; entries without it never count towards the balance.
    function validClientLedgerEntry(entryId) {
      let d = request.resource.data;
      return entryId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$')
        && d.id == entryId
        && d.keys().hasOnly(['id', 'type', 'amount', 'balanceAfter', 'createdAt', 'deviceId', 'refId', 'lang'])
        && d.keys().hasAll(['id', 'type', 'amount', 'balanceAfter', 'createdAt', 'deviceId', 'refId'])
        && d.type in ['earn_complete', 'earn_perfect', 'earn_daily', 'earn_streak', 'earn_ad', 'earn_achievement', 'earn_login',
                      'earn_season', 'earn_mission',
                      'spend_letter', 'spend_word', 'spend_check', 'spend_item', 'reconcile']
        && d.amount is int && d.amount >= -500 && d.amount <= 300
        && d.balanceAfter is int
        && d.createdAt is int && d.createdAt >= 0
        && d.deviceId is string && d.deviceId.size() >= 1 && d.deviceId.size() <= 128
        && (d.refId == null || (d.refId is string && d.refId.size() >= 1 && d.refId.size() <= 200))
        && (!('lang' in d) || d.lang in ['he', 'en']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && !touchesServerOnlyUserFields();
      allow delete: if false; // deleteAccount function

      match /progress/{puzzleId} {
        allow read, write: if isOwner(uid);
      }

      match /daily/{dailyId} {
        allow read, create, update: if isOwner(uid);
        allow delete: if false;
      }

      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validClientLedgerEntry(entryId);
        allow update, delete: if false;
      }

      match /claims/{claimId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /leaderboards/{boardId} {
      allow read: if signedIn();
      allow write: if false;

      match /entries/{entryId} {
        allow read: if signedIn();
        allow write: if false;
      }
    }

    match /dailies/{dailyId} {
      allow read: if true;
      allow write: if false;
    }

    match /manifests/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /clueStats/{clueId} {
      allow read: if true;
      allow write: if false;
    }

    match /telemetry/{document=**} {
      allow read: if false;
      allow create: if signedIn() && request.resource.data.size() <= 24;
      allow update, delete: if false;
    }

    // Username reservations (claimUsername / deleteAccount functions only).
    match /usernames/{key} {
      allow read, write: if false;
    }

    // Player feedback and clue reports (app: features/feedback): create-only for the
    // signed-in author, read and triaged (status) in the admin tools.
    match /feedback/{reportId} {
      allow read, update: if isAdmin();
      allow delete: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'message', 'email', 'context', 'createdAt', 'uid', 'status', 'receivedAt'])
        && request.resource.data.kind in ['bug', 'clue', 'idea', 'other']
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && (!('email' in request.resource.data) || (request.resource.data.email is string && request.resource.data.email.size() <= 200))
        && request.resource.data.context is map && request.resource.data.context.size() <= 16
        && request.resource.data.createdAt is int
        && request.resource.data.status == 'new'
        && request.resource.data.receivedAt == request.time;
    }

    // ---- Multiplayer (functions/README.md "Multiplayer") ----

    // Versus matches: written by Cloud Functions only; readable by the two players.
    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.players;
      allow write: if false;
    }

    // Matchmaking queue: clients call findMatch; a queued player may watch its own
    // entry to learn the matchId once it has been popped.
    match /matchQueue/{queueId} {
      allow read, write: if false;

      match /entries/{entryUid} {
        allow read: if isOwner(entryUid);
        allow write: if false;
      }
    }

    // Trophy leaderboard: public read, written by the match settlement.
    match /trophyBoard/{lang} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryUid} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Invite codes resolve to match / room ids inside the functions only.
    match /inviteCodes/{code} {
      allow read, write: if false;
    }

    // Puzzle pool for random matches (publisher-maintained) and the publish index.
    match /matchPool/{poolId} {
      allow read, write: if isAdmin();
    }

    match /puzzleIndex/{puzzleId} {
      allow read: if true;
      allow write: if false;
    }

    // Co-op rooms: membership, status and rewards are managed by the functions. A
    // member may only touch its own `members.{uid}.cursor` / `members.{uid}.lastSeenAt`.
    function isRoomMember(roomId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/coopRooms/$(roomId)).data.members;
    }

    function onlyOwnPresenceChanged() {
      let uid = request.auth.uid;
      let before = resource.data;
      let after = request.resource.data;
      return after.diff(before).affectedKeys().hasOnly(['members'])
        && after.members.diff(before.members).affectedKeys().hasOnly([uid])
        && uid in before.members
        && after.members[uid].diff(before.members[uid]).affectedKeys().hasOnly(['cursor', 'lastSeenAt'])
        && (!('cursor' in after.members[uid]) || after.members[uid].cursor == null
            || (after.members[uid].cursor is int && after.members[uid].cursor >= 0 && after.members[uid].cursor < 10000))
        && after.members[uid].lastSeenAt is int && after.members[uid].lastSeenAt >= 0;
    }

    match /coopRooms/{roomId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create, delete: if false;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && resource.data.status != 'finished'
        && onlyOwnPresenceChanged();

      // Grid cells filled by the members: {symbol: 0..31 | null, by: own uid, at: ms}.
      match /cells/{cellIndex} {
        allow read: if isRoomMember(roomId);
        allow create, update: if isRoomMember(roomId)
          && cellIndex.matches('^[0-9]{1,5}$')
          && request.resource.data.keys().hasOnly(['symbol', 'by', 'at'])
          && request.resource.data.keys().hasAll(['symbol', 'by', 'at'])
          && (request.resource.data.symbol == null
              || (request.resource.data.symbol is int && request.resource.data.symbol >= 0 && request.resource.data.symbol <= 31))
          && request.resource.data.by == request.auth.uid
          && request.resource.data.at is int && request.resource.data.at >= 0;
        allow delete: if false;
      }
    }

    match /puzzlesAuthoring/{document=**} {
      allow read, write: if isAdmin();
    }

    match /words/{document=**} {
      allow read, write: if isAdmin();
    }

    match /clues/{document=**} {
      allow read, write: if isAdmin();
    }

    match /templates/{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
