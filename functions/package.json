{
  "name": "chetz-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Firebase Functions (2nd gen, TypeScript) backend for the Chetz arrowword app: wallet ledger, RevenueCat webhook, daily leaderboard, publishing and scheduled jobs.",
  "main": "lib/index.js",
  "engines": {
    "node": "20"
  },
  "scripts": {
    "sync-schema": "node scripts/sync-schema.mjs",
    "build": "npm run sync-schema && tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,storage",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0"
  }
}
