# Copy to functions/.env.<project-id> (never committed). Values are read at deploy/emulator time.
# Region for all 2nd-gen functions (default europe-west1).
FUNCTIONS_REGION=europe-west1
# Base URL the manifests use for puzzle files: a CDN/Hosting domain in front of the bucket,
# or leave empty to use https://storage.googleapis.com/<bucket>.
CDN_BASE_URL=
# Set to false on emulator/dev projects where the app has no App Check token.
ENFORCE_APP_CHECK=true
