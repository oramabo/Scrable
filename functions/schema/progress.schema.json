{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chetz.app/schema/progress.schema.json",
  "title": "Chetz puzzle progress",
  "description": "Saved state of one puzzle attempt exactly as produced by `PuzzleProgress.toJson` in packages/core (lib/src/engine/progress.dart). Stored locally (drift) and synced to `users/{uid}/progress/{puzzleId}`. `cells` has one entry per grid cell in row-major order: `null` for clue cells, an object for letter cells.",
  "type": "object",
  "required": ["puzzleId", "puzzleVersion", "cells", "mode", "elapsedMs", "lettersRevealed", "wordsRevealed", "checksUsed", "wrongEntries", "completed", "stars", "startedAt", "lastPlayedAt", "revision"],
  "additionalProperties": false,
  "properties": {
    "puzzleId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "puzzleVersion": { "type": "integer", "minimum": 1 },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "type": "null" },
          { "$ref": "#/$defs/cellEntry" }
        ]
      }
    },
    "mode": { "type": "string", "enum": ["relaxed", "normal", "newspaper"] },
    "elapsedMs": { "type": "integer", "minimum": 0, "description": "Active solving time only." },
    "lettersRevealed": { "type": "integer", "minimum": 0 },
    "wordsRevealed": { "type": "integer", "minimum": 0 },
    "checksUsed": { "type": "integer", "minimum": 0 },
    "wrongEntries": { "type": "integer", "minimum": 0 },
    "completed": { "type": "boolean" },
    "completedAt": { "$ref": "#/$defs/epochMs" },
    "stars": { "type": "integer", "minimum": 0, "maximum": 3 },
    "startedAt": { "$ref": "#/$defs/epochMs" },
    "lastPlayedAt": { "$ref": "#/$defs/epochMs" },
    "revision": { "type": "integer", "minimum": 0, "description": "Monotone counter used by the sync merge." },
    "activeWordId": { "type": "string", "minLength": 1, "maxLength": 16 },
    "cursorCell": { "type": "integer", "minimum": 0, "description": "Row-major cell index of the cursor." }
  },
  "$defs": {
    "epochMs": { "type": "integer", "minimum": 0, "description": "Milliseconds since the Unix epoch (0 = unknown)." },
    "cellEntry": {
      "type": "object",
      "description": "Compact keys: s = symbol id (absent when empty), st = status, p = pencil (present only when true), t = updatedAt ms.",
      "required": ["st", "t"],
      "additionalProperties": false,
      "properties": {
        "s": { "type": "integer", "minimum": 0 },
        "st": { "type": "string", "enum": ["empty", "filled", "correct", "wrong", "revealed"] },
        "p": { "type": "boolean" },
        "t": { "$ref": "#/$defs/epochMs" }
      }
    }
  }
}
